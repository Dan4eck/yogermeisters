PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_KEY=
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
DEV_AUTH_EMAIL=student@example.com
S3_ENDPOINT=https://replace-with-selectel-s3-endpoint
S3_REGION=replace-with-selectel-region
S3_BUCKET=replace-with-private-bucket-name
S3_ACCESS_KEY_ID=replace-with-read-only-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-read-only-secret-access-key
S3_SIGNED_URL_TTL_SECONDS=5400
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_WEBHOOK_URL=https://replace-with-bot-service-domain/telegram/webhook
MEDITATION_AUDIO_FILE_ID=
MEDITATION_AUDIO_URL=
